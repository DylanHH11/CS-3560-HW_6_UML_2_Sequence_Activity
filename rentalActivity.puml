@startuml

|Renter|
start
:Select facility, date, time, and event type;

|Website|
:Check availability;
if (available?) then ([available])
       |Renter|
       :Enter contact information;
       :Submit request;

       |School Staff|
       :Review request;

        if(Accept request?) then ([approved])
            |Payment Service|
            :Process Payment;
                    |Website|
                    if (Payment successful?) then ([payment succeeds])
                        :Save booking;
                        |Email Service|
                        :Send rental confirmation email;
                        |Renter|
                        :Booking confirmed;
                        stop
                    else ([payment fails])
                        :Record payment failure;
                        |Email Service|
                        :Send failed payment email;
                        |Renter|
                        :Payment failed;
                        stop
                    endif
                    else ([rejected])
                        |Website|
                        :Record rejection;
                        |Email Service|
                        :Send rejection email;
                        |Renter|
                        :Request rejected;
                        stop
                    endif

else ([not available])
        |Website|
        :Show not available;
        |Renter|
        if (Try another date?) then ([choose another date])
            :Choose another date/time;
            |Website|
            :Check availability again;
            note right
              A new facility selection should loop back to the beginning
            end note
            stop
        else ([stop])
            :Stop request;
            stop
        endif

endif



@enduml