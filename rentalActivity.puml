@startuml

|Renter|
start
:Selects facility, date, time, and event type;

|Website|
:Check availability;
if (available?) then (yes)
       |Renter|
       :Enter contact information;
       :Submit request;

       |School Staff|
       :Review request;

        if(Accept request?) then ([approved])
            |Payment Service|
            :Process Payment;
            if (Payment Successful?) then ([payment succeeds])
                        :Save booking;
                        |Email Service|
                        :send rental confirmation email;
            else ([payment fails])
                           :Record payment failure;
                           |Email Service|
                           :send failed payment email;
            endif
else ([not available])
        :Show not available;
        |Renter|
        if (Try another date?) then ([choose another date])
            :Choose another date/time;
            |Website|
            :Check availability again;
            note right
              A new facility selection should loop back to the beginning
            end note
            stop
        else ([stop])
            :Stop request;
            stop
        endif





@enduml